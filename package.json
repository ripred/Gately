        "prettier": "^3.6.2",
        "rimraf": "^6.1.3",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.17",
        "tsconfig-paths": "^4.2.0",
        "turbo": "^2.9.16",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.60.1"
    },
    "packageManager": "pnpm@10.15.0",
    "pnpm": {
        "overrides": {
            "diff@>=4.0.0 <4.0.4": "4.0.4",
